  "motions": {
    "_readme": "Per piece kind. idle runs all the time (cycles = full swings per 12 s loop; keep them whole numbers so the loop is seamless); poke runs when the piece's spot is clicked (or the piece itself, if kick); hover = lift in units while the pointer is over its spot; intro = degrees of the settling wobble when the page opens. Types: rock {deg, cycles, phase, wave, spread}, bob {px, cycles}, tilt {from, to, cycles} or poke tilt {deg, time}, breathe {amount, cycles}, swing {deg, hz, decay, delay}, hop {px, time, count, falloff}, jelly {px, squash, hz, decay, air, anticipate}. groundShadow = [rx, ry] of the shadow drawn at the pivot while the piece is in the air.",
    "pine": { "intro": 7, "idle": [{ "type": "rock", "deg": [1.6, 2.2, 2.8], "cycles": [2, 3], "wave": -0.004, "spread": 0.7 }], "poke": [{ "type": "swing", "deg": 10, "hz": 1.9, "decay": 2.6 }], "pokeBurst": { "sprite": "leaf", "count": 5 }, "pokeSound": ["flap"] },
    "cabbage": { "intro": 2, "idle": [{ "type": "rock", "deg": 1, "cycles": 2 }, { "type": "bob", "px": 3, "cycles": 3 }], "poke": [{ "type": "jelly", "px": 12, "squash": 0.08, "hz": 3.2, "decay": 3.4, "air": 0.32 }], "hover": 4 },
    "dino": { "intro": 6, "idle": [{ "type": "rock", "deg": 2, "cycles": 3 }, { "type": "breathe", "amount": 0.03, "cycles": 6 }], "poke": [{ "type": "jelly", "px": 10, "squash": 0.24, "hz": 4.4, "decay": 3.2, "air": 0.3, "anticipate": 0.12 }], "groundShadow": [46, 9], "hover": 3 },
    "head": { "idle": [{ "type": "rock", "deg": 8, "cycles": 6, "phase": 1 }], "poke": [{ "type": "swing", "deg": 14, "hz": 3.6, "decay": 3, "delay": 0.14 }] },
    "building": { "intro": 1.5, "idle": [], "poke": [{ "type": "jelly", "px": 7, "squash": 0.04, "hz": 3.6, "decay": 4, "air": 0.22, "anticipate": 0.06 }], "hover": 5 },
    "sign": { "idle": [{ "type": "rock", "deg": 1.1, "cycles": 2, "wave": 0.01 }], "poke": [{ "type": "swing", "deg": 5, "hz": 2.1, "decay": 2.4, "delay": 0.1 }] },
